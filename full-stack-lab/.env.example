# Copy to .env and adjust. All images key off ZITI_VERSION.
# Default is the latest published ziti release at the time this was written.

# Project namespace. Everything is grouped under this so it will not collide with other
# docker work on the host: containers are zo-*, volumes zo_*, networks zo-*.
COMPOSE_PROJECT_NAME=zo

ZITI_VERSION=2.0.0

ZITI_CONTROLLER_IMAGE=openziti/ziti-controller:${ZITI_VERSION}
ZITI_ROUTER_IMAGE=openziti/ziti-router:${ZITI_VERSION}
ZITI_CLI_IMAGE=openziti/ziti-cli:${ZITI_VERSION}
ZITI_TUNNEL_IMAGE=openziti/ziti-tunnel:${ZITI_VERSION}
ZITI_QUICKSTART_IMAGE=openziti/quickstart:latest

# Admin password for the controller cluster.
ZITI_PWD=admin

# Cluster trust domain shared by all controller nodes.
ZITI_CLUSTER_TRUST_DOMAIN=learning.openziti.local

# Front-door hostname (HAProxy). Clients and ZAC use this.
ZITI_FRONT_DOOR=learning.openziti.local

# Control-plane network (all controllers + routers attach here for the control channel).
ZITI_NETWORK=zo-ctrl

# Controller node 1 (bootstraps the cluster).
ZITI_CTRL1_ADVERTISED_ADDRESS=ziti-controller1
ZITI_CTRL1_ADVERTISED_PORT=1280
ZITI_CTRL1_NODE_NAME=ziti-controller1

# Controller node 2.
ZITI_CTRL2_ADVERTISED_ADDRESS=ziti-controller2
ZITI_CTRL2_ADVERTISED_PORT=1282
ZITI_CTRL2_NODE_NAME=ziti-controller2

# Controller node 3.
ZITI_CTRL3_ADVERTISED_ADDRESS=ziti-controller3
ZITI_CTRL3_ADVERTISED_PORT=1283
ZITI_CTRL3_NODE_NAME=ziti-controller3

# Interface the published controller ports bind to on the Docker host.
ZITI_INTERFACE=0.0.0.0

# UID the controller containers run as (matches the official images).
ZIGGY_UID=2171
