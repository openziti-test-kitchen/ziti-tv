# Copy to .env, fill in every value, and never commit or `cat` the result.

# The controller's admin password. The quickstart sets it on the first start, so changing it later means a new
# network: delete ./.ziti first.
ZITI_PWD=admin

# From a Claude Console workspace with a spend limit.
ANTHROPIC_API_KEY=sk-ant-...

# Three virtual keys, each from `docker compose run --rm --no-deps llm-gateway llm-gateway genkey`.
CLASSIFIER_GATEWAY_KEY=sk-gw-...
MY_GATEWAY_KEY=sk-gw-...
AGENT_GATEWAY_KEY=sk-gw-...

# Your persistent zrok share, from `zrok2 create share -s <name>`, and the zrok2 environment `zrok2 enable` wrote.
SHARE=your-share-name
# ZROK2_DIR=/home/you/.zrok2

# Ollama in compose (CPU only). To use an Ollama outside compose instead, empty COMPOSE_PROFILES and point OLLAMA_URL
# at it, for example http://host.docker.internal:11434 on Docker Desktop.
COMPOSE_PROFILES=ollama
# OLLAMA_URL=http://ollama:11434

# The ziti CLI and controller image tag. Episode 3 uses `ziti login`, which needs 2.x.
# ZITI_VERSION=2.0.8

# Host ports. Change them to run next to another Appetizer stack.
# CTRL_PORT=1280
# ROUTER_PORT=3022
# APPETIZER_PORT=18000
# GATEWAY_PORT=8080

# Where episode 4's hosts and client find Ziggy's and Mallory's identities.
# ZITI_DEMO_DIR=/home/you/.ziti-demo
