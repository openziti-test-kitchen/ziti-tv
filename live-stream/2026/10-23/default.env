# Copy to .env, fill in every value, and never commit or `cat` the result. Every script here sources .env.

# Your domain. Users type https://addbyurl.$DOMAIN:$CTRL_PORT into their tunneler. Four DNS A records point at this
# machine: addbyurl, addbyurl-ctrl, addbyurl-router and addbyurl-idp, each under $DOMAIN.
DOMAIN=example.com

# Where everything lives on this machine: the ziti binaries, the controller's home, the Let's Encrypt copies.
DEMO_DIR=$HOME/addbyurl

# Passwords. The quickstart sets ZITI_PWD on its first run, so changing it later means a new network.
ZITI_PWD=change-me
KC_PWD=change-me

# Ports. Open all four, plus 80 for the Let's Encrypt challenge, in the machine's firewall or security group.
CTRL_PORT=9480
ROUTER_PORT=9490
KC_PORT=9680

# Versions this episode was built with
ZITI_VERSION=2.0.6
ZET_VERSION=1.19.1
KEYCLOAK_VERSION=26.0
