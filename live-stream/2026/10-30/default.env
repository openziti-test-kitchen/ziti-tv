# Copy to .env and edit. Every script sources .env.

# versions this episode was built and tested with
OPENZITI_VERSION=2.0.3
# ziti-access-bridge commit
ZAB_REF=8720108

# Cloudflare: the public hostname on your tunnel, and the Access application on it
ZAB_HOST=zab.example.org
CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_AUD=paste-the-application-aud-tag-here

# OpenZiti controller and the admin login the scripts use
ZITI_CTRL=127.0.0.1:1280
ZITI_USER=admin
ZITI_PASSWORD=admin
# the router that hosts the two apps. `ziti edge quickstart` names it router-instance-1
ZITI_ROUTER=router-instance-1

# three people, by the email Cloudflare Access puts in the JWT
ALICE=alice@example.com
BOB=bob@example.com
CAROL=carol@example.com

# where the two apps listen, on the router's machine
WIKI_PORT=18080
LEDGER_PORT=18081
# Keycloak demo passwords (realm acme), never committed filled in
KC_ALICE=
KC_BOB=
KC_CAROL=
KC_DAVE=
